// Generic declarative pipeline — illustrates the stage structure
// used across services: build -> quality gates -> staged deploy.
pipeline {
    agent any

    environment {
        IMAGE_NAME = "example-service"
        REGISTRY   = "registry.example.com"
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Build & Test') {
            steps {
                sh 'python -m pip install -r requirements.txt'
                sh 'python -m pytest tests/ -q'
                sh 'docker build -t $REGISTRY/$IMAGE_NAME:$BUILD_NUMBER .'
            }
        }
        stage('Quality Gates') {
            parallel {
                stage('Lint') {
                    steps { sh 'python -m flake8 src/' }
                }
                stage('Image Scan') {
                    steps { sh 'trivy image $REGISTRY/$IMAGE_NAME:$BUILD_NUMBER' }
                }
            }
        }
        stage('Deploy to Staging') {
            steps { sh 'python deploy_helper.py --env staging --tag $BUILD_NUMBER' }
        }
        stage('Smoke Tests') {
            steps { sh 'python -m pytest tests/smoke -q' }
        }
        stage('Deploy to Production') {
            when { branch 'main' }
            steps { sh 'python deploy_helper.py --env production --tag $BUILD_NUMBER' }
        }
    }

    post {
        failure { echo "Pipeline failed — notifying the team channel" }
        success { echo "Deployed $IMAGE_NAME:$BUILD_NUMBER" }
    }
}
